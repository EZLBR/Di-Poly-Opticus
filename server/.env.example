# ============================================================
#   OPTICUS BACKEND — Variáveis de Ambiente (Exemplo)
#   Copie este arquivo para .env e preencha com seus dados
#
#   Railway MySQL — mapeamento de variáveis:
#     MYSQLHOST      → DB_HOST
#     MYSQLPORT      → DB_PORT
#     MYSQLUSER      → DB_USER
#     MYSQLPASSWORD  → DB_PASSWORD
#     MYSQLDATABASE  → DB_NAME
# ============================================================

# ── Banco de Dados MySQL ────────────────────────────────────
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Autenticação JWT ────────────────────────────────────────
JWT_SECRET=

# ── Pagamentos AbacatePay (deixe em branco para usar simulador) ──
ABACATE_TOKEN=

# ── Servidor ────────────────────────────────────────────────
PORT=5000
