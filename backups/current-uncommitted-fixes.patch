+  margin-top: 18px;
+}
+
+.auth-feature-list > div {
+  padding: 16px;
+  border-radius: 18px;
+  border: 1px solid rgba(255,255,255,0.12);
+  background: rgba(8,21,34,0.24);
+}
+
+.auth-feature-list strong,
+.auth-feature-list span {
+  display: block;
+}
+
+.auth-feature-list strong {
+  margin-bottom: 6px;
+}
+
+.auth-panel {
+  padding: 30px;
