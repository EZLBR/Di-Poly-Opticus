+/* Unified auth page */
+body.page-auth-unified {
+  min-height: 100vh;
+  background:
+    radial-gradient(circle at 12% 10%, rgba(255,255,255,0.9), rgba(255,255,255,0) 26%),
+    linear-gradient(180deg, #eef3f7 0%, #d9e2eb 100%);
+  color: #0f172a;
+}
+
+.auth-shell {
+  width: min(1180px, calc(100% - 32px));
+  min-height: calc(100vh - 40px);
+  margin: 20px auto;
+  display: grid;
+  grid-template-columns: minmax(0, 1.05fr) minmax(380px, 0.95fr);
+  gap: 24px;
+  align-items: stretch;
+}
+
+.auth-surface {
+  border-radius: 30px;
+  border: 1px solid rgba(255,255,255,0.58);
+  box-shadow: 0 30px 90px rgba(15,23,42,0.12);
+  overflow: hidden;
+}
+
+.auth-hero {
+  display: flex;
+  align-items: flex-end;
+  padding: 42px;
+  color: #fff;
+  background:
+    radial-gradient(circle at top right, rgba(255,255,255,0.18), transparent 25%),
+    radial-gradient(circle at bottom left, rgba(214,169,110,0.15), transparent 28%),
+    linear-gradient(135deg, #102437 0%, #1e425f 52%, #6d8aa5 100%);
+}
+
+.auth-copy {
+  max-width: 650px;
+}
+
+.auth-badge {
+  display: inline-flex;
+  align-items: center;
+  padding: 8px 12px;
+  border-radius: 999px;
+  border: 1px solid rgba(255,255,255,0.16);
+  background: rgba(255,255,255,0.1);
+  color: rgba(255,255,255,0.86);
+  font-size: 11px;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+}
+
+.auth-copy h1 {
+  max-width: 12ch;
+  margin: 18px 0 16px;
+  font-size: 56px;
+  line-height: 0.95;
+  letter-spacing: 0;
+}
+
+.auth-copy > p {
+  max-width: 62ch;
+  color: rgba(255,255,255,0.82);
+  font-size: 16px;
+  line-height: 1.7;
+}
+
+.auth-highlight-card {
+  margin-top: 28px;
+  padding: 22px;
+  border-radius: 24px;
